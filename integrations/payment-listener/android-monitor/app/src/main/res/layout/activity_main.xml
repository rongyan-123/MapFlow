<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面（重构版）。
  兼容性约定：所有 android:id 与 android:onClick 保持与 MainActivity 的绑定不变。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vmq_background"
    android:orientation="vertical"
    tools:context=".ui.MainActivity">

    <!-- ========== 顶栏（同时承载 options menu） ========== -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@drawable/bg_toolbar"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            style="@style/Toolbar.Title"
            android:text="@string/app_name" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin_horizontal"
            android:paddingEnd="@dimen/page_margin_horizontal"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg">

            <!-- ========== 配置信息卡片 ========== -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_md"
                    android:text="@string/section_config" />

                <!-- 通知地址 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="@color/colorPrimary" />

                    <TextView
                        android:id="@+id/txt_host"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/url"
                        android:textIsSelectable="true"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 通讯密钥 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="@color/colorAccent" />

                    <TextView
                        android:id="@+id/txt_key"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/key"
                        android:textIsSelectable="true"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 通道状态 -->
                <TextView
                    android:id="@+id/txt_backup_state"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_info_panel"
                    android:drawablePadding="@dimen/space_sm"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_md"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/backup_state_default"
                    android:textColor="@color/vmq_success"
                    android:textIsSelectable="true"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ========== 操作按钮卡片 ========== -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_md"
                    android:text="@string/section_actions" />

                <!-- 扫码配置（主操作） -->
                <Button
                    android:id="@+id/btn_sm"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:onClick="startQrCode"
                    android:text="@string/sm" />

                <Button
                    android:id="@+id/btn_input"
                    style="@style/Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_sm"
                    android:onClick="doInput"
                    android:text="@string/pz" />

                <Button
                    android:id="@+id/btn_start"
                    style="@style/Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_sm"
                    android:onClick="doStart"
                    android:text="@string/xt" />

                <Button
                    android:id="@+id/btn_checkpush"
                    style="@style/Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_sm"
                    android:onClick="checkPush"
                    android:text="@string/jt" />

                <Button
                    android:id="@+id/btn_backup"
                    style="@style/Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_sm"
                    android:onClick="doBackup"
                    android:text="@string/backup_cfg" />
            </LinearLayout>

            <!-- ========== 监控日志卡片 ========== -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.SectionLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:onClick="Logs"
                        android:text="@string/ht_state" />

                    <TextView
                        android:id="@+id/sj_dl"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:maxLines="1"
                        android:onClick="dl"
                        android:text="@string/dl"
                        android:textColor="@color/vmq_success"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/logs_linear_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/state_logs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_log"
                        android:fontFamily="monospace"
                        android:gravity="top"
                        android:lineSpacingExtra="3dp"
                        android:minHeight="220dp"
                        android:padding="@dimen/space_md"
                        android:scrollbars="vertical"
                        android:textColor="@color/vmq_log_text"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/text_log" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========== 版权信息 ========== -->
            <TextView
                android:id="@+id/bq"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_sm"
                android:clickable="true"
                android:gravity="center"
                android:onClick="openAuthorWebsite"
                android:text="@string/bq"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>