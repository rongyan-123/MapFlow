<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== 应用主题 ==================== -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/vmq_background</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:textColorPrimary">@color/vmq_on_surface</item>
        <item name="android:textColorSecondary">@color/vmq_on_surface_secondary</item>
    </style>

    <!-- 兼容旧引用：无 ActionBar 主题 -->
    <style name="HideStyle" parent="AppTheme" />

    <!-- ==================== 文本样式 ==================== -->
    <style name="Text.Display" parent="">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/vmq_on_surface</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/vmq_on_surface</item>
    </style>

    <style name="Text.Subtitle" parent="">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/vmq_on_surface</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/vmq_on_surface</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/vmq_on_surface_secondary</item>
    </style>

    <!-- 区块小标题（卡片内分组标签） -->
    <style name="Text.SectionLabel" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- ==================== 卡片 ==================== -->
    <style name="Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_lg</item>
        <item name="android:layout_marginBottom">@dimen/space_md</item>
        <item name="android:elevation">@dimen/card_elevation</item>
    </style>

    <!-- ==================== 按钮 ==================== -->
    <style name="Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/vmq_on_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ==================== 列表项（设置页） ==================== -->
    <style name="SettingRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/list_item_height</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_setting_row</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingRow.Title" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/vmq_on_surface</item>
    </style>

    <style name="SettingRow.Summary" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/vmq_on_surface_secondary</item>
        <item name="android:layout_marginTop">@dimen/space_xxs</item>
    </style>

    <!-- ==================== 状态徽标 ==================== -->
    <style name="StatusBadge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:paddingTop">@dimen/space_xxs</item>
        <item name="android:paddingBottom">@dimen/space_xxs</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ==================== Toolbar ==================== -->
    <style name="Toolbar.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/vmq_on_primary</item>
    </style>

</resources>