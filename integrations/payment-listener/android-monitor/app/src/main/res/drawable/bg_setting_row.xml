<?xml version="1.0" encoding="utf-8"?>
<!-- 设置项：白底 + 底部 1dp 分隔线 + 水波纹 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#14000000">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/vmq_surface" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/vmq_divider" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>